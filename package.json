{
  "name": "dr-rodier",
  "private": true,
  "version": "0.1.0",
  "description": "Dr Rodier — plateforme personnelle de révision DFGSM 3 (UPEC)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.pipeline.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx pipeline/index.ts",
    "deploy": "npm run build && node scripts/config-deploiement.cjs && wrangler deploy --config wrangler.deploiement.json"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.25.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.15.4",
    "hono": "^4.13.19",
    "ical.js": "^2.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unpdf": "^1.9.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
